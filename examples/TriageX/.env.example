# TriageX environment — copy to .env (repo root) and fill in. Never commit .env.
# All values are read server-side only; nothing here is exposed to the frontend.

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Tiger Data (Phase 4) ---
# Service connection string from Tiger Console, e.g.
#   postgres://tsdbadmin:<password>@<service>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Leave empty to run without a database (the demo works fully in memory).
DATABASE_URL=
# Optional: keep TriageX tables in their own schema (default: the server's search_path).
DATABASE_SCHEMA=
DATABASE_POOL_SIZE=3
DATABASE_TIMEOUT_SECONDS=10

# --- AI operational brief (Prompt 6) ---
# Gemini API free tier only (no paid provider). The same key as GOOGLE_API_KEY in agent/.env.local.
# Without it the brief is the deterministic template labeled "AI unavailable".
GEMINI_API_KEY=
# Optional overrides (confirmed in Google's model docs 2026-11-14; per-model free-tier quotas).
# Defaults: primary gemini-3.1-flash-lite, fallback gemini-3.5-flash-lite.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# --- FaceTime agent -> backend (Prompt 4) ---
# Shared secret; the SAME value goes in agent/.env.local. Generate with: openssl rand -hex 32
TRIAGEX_AGENT_TOKEN=

# --- Chert hackathon line: iMessage (Prompt 5) ---
# Project API key from https://app.trychert.com/developer (owners only; starts ftk_), the project
# id, and the line id (run: cd backend && uv run python ../scripts/chert_inspect.py).
# When these three are set they take precedence over the console API below.
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=

# --- Chert console API (Phase 6, signed webhooks; not used by the hackathon line) ---
# Leave blank to run with the clearly labeled mock adapter.
CHERT_SIGNING_SECRET=
CHERT_TENANT=
CHERT_WEBHOOK_SECRET=
# Comma-separated E.164 numbers of explicitly opted-in teammates only (both Chert transports).
# On the Shared line they must also be phones verified for the Chert project.
DEMO_ALLOWED_PHONES=
# Public HTTPS base URL of the tunnel that forwards to the backend (for the Chert webhook).
PUBLIC_BASE_URL=
