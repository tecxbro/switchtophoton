# Fill these in privately in .env.local (gitignored). Never commit real values.
# All three LiveKit values must belong to one LiveKit Cloud project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# TriageX uses Gemini Live (free tier of the Gemini API) instead of the starter's OpenAI realtime model.
# Create a key at https://aistudio.google.com/apikey.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
# Optional: override the Live model (default gemini-2.5-flash-native-audio-preview-12-2025).
GEMINI_LIVE_MODEL=
# Unused by TriageX; leave empty. (chert doctor only warns about it.)
OPENAI_API_KEY=

# Staff-card reading (card-session.mjs): a Gemini Flash vision model on the same GOOGLE_API_KEY.
# gemini-3.5-flash-lite: stable, image input, structured output (confirmed in Google's model docs 2026-11-14).
VISION_MODEL=gemini-3.5-flash-lite
# Optional: CARD_AUTO_RESCAN=1 starts a new card scan a few seconds after each read or timeout
# (development: test several cards in one short call without voice commands).
CARD_AUTO_RESCAN=

# Optional: FRAME_PROBE=1 also runs the Stage C caller-video frame probe (frame-probe.mjs). Off by default.
FRAME_PROBE=

# Prompt 4: the TriageX backend (FastAPI, bound to 127.0.0.1) and the shared agent token.
# TRIAGEX_AGENT_TOKEN must equal TRIAGEX_AGENT_TOKEN in the repo's .env. Without it the agent
# only reads cards and says nothing can be confirmed.
BACKEND_URL=http://127.0.0.1:8000
TRIAGEX_AGENT_TOKEN=

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=triagex-facetime-agent
